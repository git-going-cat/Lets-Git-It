# .gitkeep — 빈 폴더를 git에 올리기 위한 플레이스홀더 파일
# 절대 무시되면 안 됨
!**/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 개발 도구 캐시
.tanstack/
.vite/

# 환경변수 파일 (git에 올리지 않음)
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
