# OpenRouter (LLM + Embeddings)
OPENROUTER_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX_NAME=lgi-progit-ko

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# App settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DAILY_LIMIT_PER_IP=100

# nginx 등 리버스 프록시 뒤에 배치할 때만 true (X-Forwarded-For 신뢰)
# 직접 노출 환경에서는 반드시 false 유지 — IP 스푸핑으로 rate limit 우회 가능
TRUST_FORWARDED_FOR=false
