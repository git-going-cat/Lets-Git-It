# nginx 환경별 설정 — 실제 값을 채워서 .env.nginx 파일로 복사해 사용하세요
# .env.nginx 파일은 git에 커밋하지 않습니다 (.gitignore에 등록됨)

# 개발 예시
DOMAIN_FRONTEND=dev.lets-git-it.kr
DOMAIN_API=api-dev.lets-git-it.kr
DOMAIN_GRAFANA=grafana-dev.lets-git-it.kr
DOMAIN_REDIS=redis-dev.lets-git-it.kr
DOMAIN_AGENT=agent-dev.lets-git-it.kr
SSL_CERT=/etc/letsencrypt/live/dev.lets-git-it.kr/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/dev.lets-git-it.kr/privkey.pem
CORS_ORIGIN=https://dev.lets-git-it.kr

# 운영 예시
# DOMAIN_FRONTEND=lets-git-it.kr
# DOMAIN_API=api.lets-git-it.kr
# DOMAIN_GRAFANA=grafana.lets-git-it.kr
# DOMAIN_REDIS=redis.lets-git-it.kr
# DOMAIN_AGENT=agent.lets-git-it.kr
# SSL_CERT=/etc/letsencrypt/live/lets-git-it.kr/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/lets-git-it.kr/privkey.pem
# CORS_ORIGIN=https://lets-git-it.kr